{
  "name": "@switchboard/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Switchboard desktop: your bots, models, channels and approvals.",
  "author": "TechLoop",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "start": "node ../../node_modules/electron/cli.js .",
    "test": "node --test test/navigation.test.ts",
    "smoke": "node ../../node_modules/electron/cli.js test/smoke.mjs",
    "smoke:packaged": "node test/packaged-smoke.mjs",
    "dist": "node ../../node_modules/electron-builder/cli.js --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@switchboard/core": "0.1.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.18.0"
  }
}
