{
  "expo": {
    "name": "Switchboard",
    "slug": "switchboard",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1020",
    "scheme": "switchboard",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1020"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ca.techloop.switchboard",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Switchboard uses the camera only to scan the pairing QR code shown by your computer."
      }
    },
    "android": {
      "package": "ca.techloop.switchboard",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B1020",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": true,
      "usesCleartextTraffic": true
    },
    "updates": { "enabled": false },
    "owner": "focust",
    "plugins": [
      ["expo-camera", { "cameraPermission": "Switchboard uses the camera only to scan the pairing QR code shown by your computer." }],
      ["expo-notifications", { "color": "#F5C542" }],
      "expo-secure-store",
      "./plugins/with-cmake-object-path-max.js"
    ]
  }
}
