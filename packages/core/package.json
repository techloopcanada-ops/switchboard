{
  "name": "@switchboard/core",
  "version": "0.1.0",
  "description": "Switchboard daemon: bots on any LLM, gateways, approvals, workflows, skills and memory.",
  "license": "MIT",
  "author": "TechLoop",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "switchboard": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "start": "node dist/cli.js start",
    "dev": "node --experimental-strip-types src/cli.ts start"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "croner": "^9.0.0",
    "discord.js": "^14.16.0",
    "grammy": "^1.30.0",
    "typebox": "^1.3.27",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
